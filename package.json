{
  "name": "kiosko",
  "private": true,
  "version": "0.1.6",
  "description": "Kiosco para administrar negocios, inventario, pedidos y ventas",
  "author": "Qelvis",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "android": "npm run build && npx cap sync android && npx cap open android",
    "desktop": "npm run build && electron .",
    "desktop:build": "npm run build && electron-builder build --win portable",
    "desktop:store": "npm run build && electron-builder build --win appx"
  },
  "build": {
    "appId": "com.fogon.kiosco",
    "productName": "Kiosko",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "web-dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": ["portable"],
      "icon": "build/icon.ico"
    },
    "appx": {
      "publisherDisplayName": "Qelvis",
      "publisher": "CN=F23D3FDE-C721-4D89-931F-3F58AFAE6618",
      "identityName": "Qelvis.Kiosko",
      "backgroundColor": "#151515"
    }
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@supabase/supabase-js": "^2.45.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.8",
    "wait-on": "^9.1.0"
  }
}
